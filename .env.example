# ─── Base de datos ───────────────────────────────────────────────
# Local: `npm run db:up` levanta Postgres en docker con esta URL.
# Producción: la connection string *pooled* de Neon (https://neon.tech).
DATABASE_URL=postgresql://ahorria:ahorria@localhost:54329/ahorria
# Opcional: conexión directa (sin pooler) para migraciones en Neon. Vacía = usa DATABASE_URL.
DIRECT_URL=
# Solo para tests de la API (la crea docker-compose).
TEST_DATABASE_URL=postgresql://ahorria:ahorria@localhost:54329/ahorria_test

# ─── Sesión ──────────────────────────────────────────────────────
# Secreto para firmar la cookie. Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ─── Login con Google ────────────────────────────────────────────
# OAuth Client ID (tipo "Aplicación web") de https://console.cloud.google.com/apis/credentials
# Va dos veces: el server lo usa para verificar el token y el front para mostrar el botón.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Solo en local: permite entrar sin Google eligiendo una persona (nunca funciona en Vercel).
ALLOW_DEV_LOGIN=false

# ─── IA (opcional) ───────────────────────────────────────────────
# Sin ninguna key la app funciona igual, sin la carga por texto libre.
# Orden de proveedores (el primero es el principal; si falla, el siguiente). Los que no tienen key se saltean.
LLM_PROVIDER=groq,openrouter
# Groq (gratis, sin tarjeta, muy rápido): https://console.groq.com/keys
GROQ_API_KEY=
# Uno o varios modelos separados por coma (fallback en orden).
GROQ_MODEL=openai/gpt-oss-20b
# OpenRouter (router de modelos gratis): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# "custom": cualquier otro endpoint compatible con OpenAI (OpenAI, Claude, Ollama…). Sumalo a LLM_PROVIDER.
# Claude: LLM_BASE_URL=https://api.anthropic.com/v1 y LLM_MODEL=claude-haiku-4-5
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Log por llamada (proveedor, modelo, latencia, tokens; nunca el texto). Temporal; "false" lo apaga.
LLM_LOG=true
